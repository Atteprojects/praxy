<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Feeds the `///` comments already on endpoint handlers and DTOs into the OpenAPI document
         (.NET 10's Microsoft.AspNetCore.OpenApi reads them via a source generator).

         The two suppressions are deliberate: this is switched on to publish the comments that exist,
         not to mandate exhaustive documentation. CS1591 would demand a comment on every public
         member; CS1573 would demand that documenting one record parameter means documenting all of
         them, which turns a single useful note into eleven filler ones. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Praxy.Core\Praxy.Core.csproj" />
    <ProjectReference Include="..\Praxy.Events\Praxy.Events.csproj" />
    <ProjectReference Include="..\Praxy.Persistence\Praxy.Persistence.csproj" />
    <ProjectReference Include="..\Praxy.Auth\Praxy.Auth.csproj" />
    <ProjectReference Include="..\Praxy.Tables\Praxy.Tables.csproj" />
    <ProjectReference Include="..\Praxy.Realtime\Praxy.Realtime.csproj" />
    <ProjectReference Include="..\Praxy.Webhooks\Praxy.Webhooks.csproj" />
    <ProjectReference Include="..\Praxy.Functions\Praxy.Functions.csproj" />
    <ProjectReference Include="..\Praxy.Messaging\Praxy.Messaging.csproj" />
    <ProjectReference Include="..\Praxy.Sites\Praxy.Sites.csproj" />
    <ProjectReference Include="..\Praxy.Storage\Praxy.Storage.csproj" />
  </ItemGroup>

</Project>
