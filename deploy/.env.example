# Copy to .env — or just run ./up.sh, which asks one question (public domain, or blank for
# local/plain HTTP) and generates one with fresh secrets.
POSTGRES_PASSWORD=change-me
PRAXY_PORT=8080
# Set to your public origin (e.g. https://praxy.example.com) to require the logged
# setup token when claiming the instance.
PRAXY_PUBLIC_URL=
# Public deployment with automatic HTTPS: set all four (PRAXY_BIND=127.0.0.1 keeps the plain-HTTP
# api port reachable only from the host itself, not the public internet), then
# `docker compose --profile https up -d` instead of ./up.sh. See docs/self-host.md.
PRAXY_DOMAIN=
PRAXY_TRUST_FORWARDED_HEADERS=false
PRAXY_BIND=0.0.0.0
# Optional extra hostname for the "https" Caddy profile — e.g. console.your.domain.com — that gets
# its own automatic Let's Encrypt cert and proxies to the same api container as PRAXY_DOMAIN. The
# console is served at the root path for any hostname, so this is purely a cosmetic alias; DNS for
# it must also point at this host. Leave blank to skip it — PRAXY_DOMAIN alone works fine.
PRAXY_CONSOLE_DOMAIN=
