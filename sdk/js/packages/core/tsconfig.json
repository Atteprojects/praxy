{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Deliberately normal ambient-type visibility here (unlike tsconfig.build.json) — this config
    // also typechecks test/, which legitimately uses Node (node:fs, __dirname) to statically scan
    // src/ for edge-unsafe imports. The actual edge-safety enforcement is tsconfig.build.json's
    // "types": [] (scoped to src/ only) plus that static-scan test itself.
    "noEmit": true
  },
  "include": ["src", "test"]
}
