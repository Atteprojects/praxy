# Copy to .env.local and fill in with real values from your local Praxy console.
# Create a project, a database, and a "todos" table (columns: title string required, done boolean
# default false) with `users` role granted create/read/update/delete before running this app.

NEXT_PUBLIC_PRAXY_ENDPOINT=http://localhost:5090
NEXT_PUBLIC_PRAXY_PROJECT_ID=
NEXT_PUBLIC_PRAXY_DATABASE_ID=
NEXT_PUBLIC_PRAXY_TODOS_TABLE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
